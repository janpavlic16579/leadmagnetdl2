{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kalkulator",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "kalkulator-lokalni-webhook",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "VITE_LEAD_WEBHOOK_URL=http://localhost:8787/hook PORT=5199 npm run dev"
      ],
      "port": 5199
    }
  ]
}
