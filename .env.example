# Vzorec. Kopirajte v `.env` (ta je v .gitignore) in izpolnite.
# V objavi vrednosti ne bere .env, ampak repozitorijske spremenljivke (`vars`)
# v .github/workflows/deploy.yml.

# Kam se ob oddaji obrazca pošlje lead (izvozni zapis + prodajna priprava v HTML).
# Na isti naslov gredo tudi dogodki lijaka (src/lib/funnel.ts) — brez osebnih
# podatkov; sprejemnik ju loči po obliki telesa.
# Brez njega aplikacija deluje naprej, a strankino poročilo ne gre po e-pošti
# (stranka ga prenese z gumbom), prodajna priprava se prenese STRANKI in do
# Datalaba ne pride nič — glej README, poglavje "Kaj se zgodi ob oddaji".
# Za beleženje v Google Sheet: naslov razmestitve Apps Scripta iz
# tools/google-sheet/README.md (konča se z /exec).
VITE_LEAD_WEBHOOK_URL=

# Javni naslov objave, npr. https://www.datalab.si/leadmagnetdl/
# Brez njega gradnja ne vstavi canonical, og:url in og:image.
VITE_PUBLIC_URL=

# Pot objave — samo, kadar stran NE stoji v korenu domene. Privzeto '/' (Vercel).
# GitHub Pages jo nastavi v .github/workflows/deploy.yml na /leadmagnetdl2/.
# Poševnici na obeh koncih doda gradnja sama.
VITE_BASE_PATH=

# Žeton internega načina (?debug=<žeton>): prodajna priprava se ponudi v prenos,
# rezultati nosijo oznako "[interno]", obisk je izvzet iz lijaka. Prazno = način
# izklopljen. Ni skrivnost (VITE_ = javni sveženj), je pa neuganljiv —
# glej src/lib/internalMode.ts.
VITE_INTERNAL_TOKEN=
